rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador de origen (vos). Además, cualquier usuario con rol "admin" en /usuarios.
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function tienePerfil() { return exists(/databases/$(database)/documents/usuarios/$(email())); }
    function isAdmin() {
      return signedIn() && (email() == 'cocojleguizamon@gmail.com'
        || (tienePerfil() && perfil().rol == 'admin' && perfil().activo == true));
    }
    function activo() { return signedIn() && tienePerfil() && perfil().activo == true; }
    function esGestion() { return isAdmin() || (activo() && perfil().rol == 'coordinador'); }

    // Usuarios: cada uno lee su propio perfil; admin y coordinación leen todos; solo el admin escribe.
    match /usuarios/{uid} {
      allow read: if esGestion() || (signedIn() && email() == uid);
      allow write: if isAdmin();
    }

    // Sedes y materias: las leen los usuarios habilitados; solo el admin las modifica.
    match /sedes/{id} {
      allow read: if isAdmin() || activo();
      allow write: if isAdmin();
    }
    match /materias/{id} {
      allow read: if isAdmin() || activo();
      allow write: if isAdmin();
    }

    // Calendario académico: lo leen todos los habilitados; solo el admin lo edita.
    match /calendario/{id} {
      allow read: if isAdmin() || activo();
      allow write: if isAdmin();
    }

    // Programas: el docente crea/actualiza los suyos (siempre quedan "cargado");
    // admin y coordinación leen todos y aprueban/devuelven.
    match /programas/{id} {
      allow read: if esGestion() || (activo() && resource.data.docenteEmail == email());
      allow create, update: if (activo()
          && request.resource.data.docenteEmail == email()
          && request.resource.data.estado == 'cargado'
          && (resource == null || resource.data.docenteEmail == email()))
        || esGestion();
      allow delete: if isAdmin();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
