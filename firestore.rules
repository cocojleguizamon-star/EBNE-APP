rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Equipo de gestión: cuentas de Google ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function tienePerfil() { return exists(/databases/$(database)/documents/usuarios/$(email())); }
    // ---------- Ingreso por clave (anónimo): cátedras y áreas ----------
    function esDoc() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function ses() { return get(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data; }
    function catId(s, m) { return s + '__' + m; }
    // Sesión de un área vigente: la clave guardada sigue siendo la actual del área.
    function conArea() {
      return esDoc()
        && exists(/databases/$(database)/documents/sesiones/$(request.auth.uid))
        && ses().keys().hasAny(['area'])
        && exists(/databases/$(database)/documents/areas/$(ses().area))
        && get(/databases/$(database)/documents/areas/$(ses().area)).data.clave == ses().clave;
    }
    function areaEs(a) { return conArea() && ses().area == a; }

    // Administrador total: propietario (Google), admins en /usuarios, y las áreas Gestión y Coordinación-Rectoría.
    function isAdmin() {
      return (signedIn() && (email() == 'cocojleguizamon@gmail.com'
        || (tienePerfil() && (perfil().rol == 'admin' || perfil().rol == 'coordinador') && perfil().activo == true)))
        || areaEs('gestion') || areaEs('coordinacion');
    }
    // Puede mirar el seguimiento: administrador total + Secretaría.
    function isLector() { return isAdmin() || areaEs('secretaria'); }
    // Calendario: lo ven además Administración (contable).
    function veCalendario() { return isLector() || areaEs('administracion'); }
    // La sesión vale mientras la clave guardada siga siendo la vigente de esa cátedra.
    function sesionOk() {
      return esDoc()
        && exists(/databases/$(database)/documents/sesiones/$(request.auth.uid))
        && ses().keys().hasAny(['sedeId'])
        && get(/databases/$(database)/documents/catedras/$(catId(ses().sedeId, ses().materiaId))).data.clave == ses().clave;
    }

    // Sedes y materias: públicas (solo nombres), para armar el selector de ingreso.
    match /sedes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /materias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Usuarios del equipo de gestión.
    match /usuarios/{uid} {
      allow read: if isAdmin() || (signedIn() && email() == uid);
      allow write: if isAdmin();
    }

    // Cátedras: clave y mails de aviso. Solo la administración las ve y edita.
    match /catedras/{id} {
      allow read, write: if isAdmin();
    }

    // Sesiones docentes: cada una crea la suya si la clave coincide con la de la cátedra.
    // Claves de las áreas (Gestión, Administración, Coordinación-Rectoría, Secretaría).
    match /areas/{id} {
      allow read, write: if isAdmin();
    }

    match /sesiones/{uid} {
      allow create, update: if esDoc() && request.auth.uid == uid
        && request.resource.data.clave is string
        && request.resource.data.clave.size() >= 4
        && (
          (request.resource.data.keys().hasOnly(['sedeId', 'materiaId', 'clave', 'creada'])
            && get(/databases/$(database)/documents/catedras/$(catId(request.resource.data.sedeId, request.resource.data.materiaId))).data.clave == request.resource.data.clave)
          ||
          (request.resource.data.keys().hasOnly(['area', 'clave', 'creada'])
            && get(/databases/$(database)/documents/areas/$(request.resource.data.area)).data.clave == request.resource.data.clave)
        );
      allow read, delete: if esDoc() && request.auth.uid == uid;
    }

    // Calendario académico: lo lee la administración y cualquier docente con sesión válida.
    match /calendario/{id} {
      allow read: if veCalendario() || sesionOk();
      allow write: if isAdmin();
    }

    // Programas: un documento por cátedra (sede__materia).
    // El equipo docente lo carga y actualiza (siempre queda "cargado"); si ya está aprobado, no lo toca.
    // La administración lee todos y aprueba/devuelve.
    match /programas/{id} {
      allow read: if isLector() || (sesionOk() && id == catId(ses().sedeId, ses().materiaId));
      allow create, update: if isAdmin()
        || (sesionOk()
            && id == catId(ses().sedeId, ses().materiaId)
            && request.resource.data.sedeId == ses().sedeId
            && request.resource.data.materiaId == ses().materiaId
            && request.resource.data.estado == 'cargado'
            && (resource == null || resource.data.estado != 'aprobado'));
      allow delete: if isAdmin();
    }

    // Horario de cada cátedra: lo carga la administración; lo ven la cátedra, los lectores y Administración (contable).
    match /horarios/{id} {
      allow read: if isLector() || areaEs('administracion') || (sesionOk() && id == catId(ses().sedeId, ses().materiaId));
      allow write: if isAdmin();
    }

    // Libro de temas: un documento por clase (sede__materia__fecha). Lo carga y edita el equipo docente de esa cátedra.
    match /libros/{id} {
      allow read: if isLector() || areaEs('administracion')
        || (sesionOk() && resource.data.sedeId == ses().sedeId && resource.data.materiaId == ses().materiaId);
      allow create, update: if isAdmin()
        || (sesionOk()
            && request.resource.data.sedeId == ses().sedeId
            && request.resource.data.materiaId == ses().materiaId
            && id == catId(ses().sedeId, ses().materiaId) + '__' + request.resource.data.fecha);
      allow delete: if isAdmin();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
