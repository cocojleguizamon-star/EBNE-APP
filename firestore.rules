rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Equipo de gestión: cuentas de Google ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(email())).data; }
    function tienePerfil() { return exists(/databases/$(database)/documents/usuarios/$(email())); }
    // Administrador de origen (Coco) + quienes figuren como admin activo en /usuarios.
    function isAdmin() {
      return signedIn() && (email() == 'cocojleguizamon@gmail.com'
        || (tienePerfil() && (perfil().rol == 'admin' || perfil().rol == 'coordinador') && perfil().activo == true));
    }

    // ---------- Equipo docente: ingreso anónimo + clave de cátedra ----------
    function esDoc() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function ses() { return get(/databases/$(database)/documents/sesiones/$(request.auth.uid)).data; }
    function catId(s, m) { return s + '__' + m; }
    // La sesión vale mientras la clave guardada siga siendo la vigente de esa cátedra.
    function sesionOk() {
      return esDoc()
        && exists(/databases/$(database)/documents/sesiones/$(request.auth.uid))
        && get(/databases/$(database)/documents/catedras/$(catId(ses().sedeId, ses().materiaId))).data.clave == ses().clave;
    }

    // Sedes y materias: públicas (solo nombres), para armar el selector de ingreso.
    match /sedes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /materias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Usuarios del equipo de gestión.
    match /usuarios/{uid} {
      allow read: if isAdmin() || (signedIn() && email() == uid);
      allow write: if isAdmin();
    }

    // Cátedras: clave y mails de aviso. Solo la administración las ve y edita.
    match /catedras/{id} {
      allow read, write: if isAdmin();
    }

    // Sesiones docentes: cada una crea la suya si la clave coincide con la de la cátedra.
    match /sesiones/{uid} {
      allow create, update: if esDoc() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sedeId', 'materiaId', 'clave', 'creada'])
        && request.resource.data.clave is string
        && request.resource.data.clave.size() >= 4
        && get(/databases/$(database)/documents/catedras/$(catId(request.resource.data.sedeId, request.resource.data.materiaId))).data.clave == request.resource.data.clave;
      allow read, delete: if esDoc() && request.auth.uid == uid;
    }

    // Calendario académico: lo lee la administración y cualquier docente con sesión válida.
    match /calendario/{id} {
      allow read: if isAdmin() || sesionOk();
      allow write: if isAdmin();
    }

    // Programas: un documento por cátedra (sede__materia).
    // El equipo docente lo carga y actualiza (siempre queda "cargado"); si ya está aprobado, no lo toca.
    // La administración lee todos y aprueba/devuelve.
    match /programas/{id} {
      allow read: if isAdmin() || (sesionOk() && id == catId(ses().sedeId, ses().materiaId));
      allow create, update: if isAdmin()
        || (sesionOk()
            && id == catId(ses().sedeId, ses().materiaId)
            && request.resource.data.sedeId == ses().sedeId
            && request.resource.data.materiaId == ses().materiaId
            && request.resource.data.estado == 'cargado'
            && (resource == null || resource.data.estado != 'aprobado'));
      allow delete: if isAdmin();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
